{
  "name": "@workspace/family-feud-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Capacitor Android wrapper for Friendly Feud — points the app at the live https://friendlyfeud.fun server.",
  "scripts": {
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "cap:open": "cap open android",
    "build:apk:debug": "cd android && ./gradlew assembleDebug",
    "build:apk:release": "cd android && ./gradlew assembleRelease",
    "build:aab:release": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/core": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1"
  }
}
